# ============================================================
# Oilseed Value Chain Platform — AI Microservice Environment
# ============================================================
# Copy this file to .env and fill in your actual values.

AI_SERVICE_PORT=8000
FLASK_ENV=development
FLASK_DEBUG=1

# Supabase Credentials (same project as Node backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Bucket
SUPABASE_ML_BUCKET=ml-models

# Allowed Origins (Node.js backend & frontend in dev)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000
